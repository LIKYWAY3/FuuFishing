    @{
        ViewData["Title"] = "Chi tiết sản phẩm";
        Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    }

    <div class="container my-5 py-5">

        <!-- Loading -->
        <div id="product-loading"
             class="d-flex justify-content-center align-items-center py-5">

            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>

            <h3 class="text-muted ms-3">
                Đang tải thông tin sản phẩm...
            </h3>
        </div>

        <!-- Thông báo lỗi tải sản phẩm -->
        <div id="product-error"
             class="alert alert-danger text-center py-4 d-none">

            <h4>Rất tiếc, đã xảy ra lỗi</h4>

            <p id="product-error-message"></p>

            <a href="/shop" class="btn btn-primary">
                Quay lại cửa hàng
            </a>
        </div>

        <!-- Nội dung sản phẩm -->
        <div id="product-content" class="row d-none">

            <!-- Cột ảnh sản phẩm -->
            <div class="col-md-5">
                <div class="bg-white rounded shadow-sm p-3">

                    <img id="product-image"
                         src="/images/no-image.png"
                         alt="Ảnh sản phẩm"
                         class="img-fluid rounded"
                         style="
                            width: 100%;
                            min-height: 420px;
                            max-height: 520px;
                            object-fit: contain;
                         ">

                </div>
            </div>

            <!-- Cột thông tin sản phẩm -->
            <div class="col-md-7 mt-4 mt-md-0">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">

                        <li class="breadcrumb-item">
                            <a href="/"
                               style="text-decoration: none; color: #555;">
                                Trang chủ
                            </a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/shop"
                               style="text-decoration: none; color: #555;">
                                Sản phẩm
                            </a>
                        </li>

                        <li id="breadcrumb-product-name"
                            class="breadcrumb-item active"
                            aria-current="page">
                            Chi tiết sản phẩm
                        </li>

                    </ol>
                </nav>

                <!-- Tên sản phẩm -->
                <h1 id="product-name"
                    class="display-6 fw-bold"
                    style="color: #2b3a28;">
                </h1>

                <!-- Giá bán -->
                <div class="mt-3">

                    <h2 id="product-price"
                        class="text-danger fw-bold mb-0">
                    </h2>

                    <div id="original-price-container"
                         class="mt-1 d-none">

                        <span id="product-original-price"
                              class="text-muted text-decoration-line-through">
                        </span>

                    </div>

                </div>

                <!-- Mô tả -->
                <div class="mt-4">
                    <p id="product-description"
                       class="text-muted"
                       style="line-height: 1.8;">
                    </p>
                </div>

                <!-- Thông báo thêm giỏ hàng -->
                <div id="cart-message" class="mt-3"></div>

                <!-- Số lượng và nút thêm giỏ -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-4">

                    <label for="qty" class="fw-bold mb-0">
                        Số lượng:
                    </label>

                    <input type="number"
                           id="qty"
                           class="form-control text-center"
                           value="1"
                           min="1"
                           max="99"
                           style="width: 90px;">

                    <button type="button"
                            id="btn-add-to-cart"
                            class="btn btn-success btn-lg"
                            style="
                                background-color: #121617;
                                border-color: #3b5d49;
                            ">

                        <i class="fas fa-shopping-cart me-2"></i>
                        <span>Thêm vào giỏ</span>

                    </button>

                </div>

            </div>
        </div>

        <!-- KHU VỰC BÌNH LUẬN & ĐÁNH GIÁ -->
        <div id="reviews-section" class="mt-5 pt-4 border-top">
            <h3 class="fw-bold mb-4" style="color: #2b3a28;">
                <i class="far fa-comments me-2"></i>Đánh giá & Bình luận sản phẩm
            </h3>

            <!-- Thống kê đánh giá -->
            <div class="row align-items-center mb-4 bg-light p-3 rounded shadow-sm">
                <div class="col-md-4 text-center border-end">
                    <h1 id="avg-rating-score" class="display-4 fw-bold text-warning mb-0">0.0</h1>
                    <div id="avg-rating-stars" class="text-warning my-1 fs-5">
                        <i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i>
                    </div>
                    <span id="total-reviews-count" class="text-muted fs-6">0 bình luận</span>
                </div>
                <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                    <h5 class="fw-bold">Quy định bình luận:</h5>
                    <ul class="text-muted mb-0 small">
                        <li>Chỉ những tài khoản đã <strong>đăng nhập</strong> mới được phép viết bình luận.</li>
                        <li>Hệ thống <strong>tự động lấy tên tài khoản</strong> của bạn để bình luận (không cần chọn/nhập tên).</li>
                        <li>Vui lòng giữ lịch sự và tuân thủ chuẩn mực văn hóa khi bình luận.</li>
                    </ul>
                </div>
            </div>

            <!-- Form viết bình luận -->
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3">Viết nhận xét của bạn</h5>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form id="form-add-review">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tài khoản bình luận (Tự động):</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-user-check text-success"></i></span>
                                    <input type="text" class="form-control bg-light fw-bold text-dark" value="@User.Identity.Name" readonly disabled />
                                </div>
                                <small class="text-muted">Tên hiển thị được tự động trích xuất từ tài khoản đang đăng nhập.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Đánh giá sản phẩm:</label>
                                <div class="star-rating-select fs-4 text-warning">
                                    <input type="hidden" id="review-rating" value="5" />
                                    <i class="fas fa-star star-btn" data-value="1" style="cursor: pointer;"></i>
                                    <i class="fas fa-star star-btn" data-value="2" style="cursor: pointer;"></i>
                                    <i class="fas fa-star star-btn" data-value="3" style="cursor: pointer;"></i>
                                    <i class="fas fa-star star-btn" data-value="4" style="cursor: pointer;"></i>
                                    <i class="fas fa-star star-btn" data-value="5" style="cursor: pointer;"></i>
                                    <span id="rating-label" class="fs-6 text-muted ms-2">(5/5 Sao - Rất tốt)</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="review-comment" class="form-label fw-bold">Nội dung bình luận:</label>
                                <textarea id="review-comment" class="form-control" rows="3" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm này..." required maxlength="1000"></textarea>
                            </div>

                            <div id="review-form-message" class="mb-3"></div>

                            <button type="submit" id="btn-submit-review" class="btn btn-success px-4" style="background-color: #3b5d49; border-color: #3b5d49;">
                                <i class="fas fa-paper-plane me-2"></i>Gửi bình luận
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                            <i class="fas fa-lock fs-3 me-3 text-warning"></i>
                            <div>
                                <strong>Bạn cần đăng nhập để bình luận!</strong><br />
                                Chỉ thành viên đã đăng nhập mới có thể gửi nhận xét. 
                                <a href="/account/login?returnUrl=@(Url.Action("Detail", "Product", new { id = ViewBag.ProductId }))" class="btn btn-sm btn-dark ms-2">Đăng nhập ngay</a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Danh sách bình luận -->
            <div class="reviews-list-container">
                <h5 class="fw-bold mb-3">Tất cả bình luận</h5>
                <div id="reviews-loading" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                    <span class="ms-2 text-muted">Đang tải bình luận...</span>
                </div>
                <div id="reviews-list"></div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const productIdFromRoute = 
                Number.parseInt('@ViewBag.ProductId', 10) || 
                Number.parseInt(window.location.pathname.split('/').filter(Boolean).pop(), 10) || 0;

            let currentProductId = 0;

            const currentUserId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';

            document.addEventListener("DOMContentLoaded", function () {
                loadProductDetail();
                loadReviews(productIdFromRoute);

                document
                    .getElementById("btn-add-to-cart")
                    ?.addEventListener("click", addToCart);

                const reviewForm = document.getElementById("form-add-review");
                if (reviewForm) {
                    reviewForm.addEventListener("submit", handleReviewSubmit);
                    initStarRating();
                }
            });

            // ==================== LOAD PRODUCT ====================

            async function loadProductDetail() {
                if (productIdFromRoute <= 0) {
                    showProductError("ID sản phẩm không hợp lệ.");
                    return;
                }

                try {
                    const response = await fetch(
                        `/api/products/${productIdFromRoute}`,
                        {
                            method: "GET",
                            credentials: "include",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );

                    const result = await readJsonResponse(response);

                    if (!response.ok) {
                        throw new Error(
                            result?.message
                            ?? result?.error
                            ?? "Không tìm thấy sản phẩm."
                        );
                    }

                    // Hỗ trợ API trả trực tiếp hoặc bọc trong thuộc tính data
                    const product = result?.data ?? result;

                    if (!product) {
                        throw new Error("Dữ liệu sản phẩm không hợp lệ.");
                    }

                    renderProduct(product);
                }
                catch (error) {
                    console.error("Load product detail error:", error);

                    showProductError(
                        error?.message
                        ?? "Không thể tải thông tin sản phẩm."
                    );
                }
            }

            // ==================== RENDER PRODUCT ====================

            function renderProduct(product) {
                currentProductId = Number(
                    product.productId
                    ?? product.id
                    ?? productIdFromRoute
                );

                if (!Number.isInteger(currentProductId)
                    || currentProductId <= 0) {

                    showProductError(
                        "Không xác định được ID sản phẩm."
                    );

                    return;
                }

                const productName =
                    product.productName
                    ?? product.name
                    ?? "Sản phẩm";

                const description =
                    product.description
                    ?? product.shortDescription
                    ?? "Chưa có mô tả cho sản phẩm này.";

                const price = Number(
                    product.price
                    ?? product.salePrice
                    ?? 0
                );

                const originalPrice = Number(
                    product.originalPrice
                    ?? product.price
                    ?? 0
                );

                const imageUrl =
                    product.thumbnailUrl
                    ?? product.imageUrl
                    ?? product.images?.[0]?.imageUrl
                    ?? product.images?.[0]
                    ?? "/images/no-image.png";

                // Gán tên sản phẩm
                document.getElementById("product-name").textContent =
                    productName;

                document.getElementById(
                    "breadcrumb-product-name"
                ).textContent = productName;

                // Gán mô tả
                document.getElementById(
                    "product-description"
                ).textContent = description;

                // Gán giá
                document.getElementById(
                    "product-price"
                ).textContent = formatCurrency(price);

                // Hiển thị giá gốc nếu có giảm giá
                const originalPriceContainer =
                    document.getElementById(
                        "original-price-container"
                    );

                if (originalPrice > price) {
                    document.getElementById(
                        "product-original-price"
                    ).textContent = formatCurrency(originalPrice);

                    originalPriceContainer.classList.remove("d-none");
                }
                else {
                    originalPriceContainer.classList.add("d-none");
                }

                // Gán ảnh
                const productImage =
                    document.getElementById("product-image");

                productImage.src = imageUrl;
                productImage.alt = productName;

                productImage.onerror = function () {
                    this.onerror = null;
                    this.src = "/images/no-image.png";
                };

                // Ẩn loading, hiện nội dung
                document
                    .getElementById("product-loading")
                    .classList.add("d-none");

                document
                    .getElementById("product-content")
                    .classList.remove("d-none");
            }

            // ==================== ADD TO CART ====================

            async function addToCart() {
                const quantityInput =
                    document.getElementById("qty");

                const quantity =
                    Number.parseInt(quantityInput.value, 10);

                clearCartMessage();

                if (!Number.isInteger(currentProductId)
                    || currentProductId <= 0) {

                    showCartMessage(
                        "Không xác định được sản phẩm.",
                        "danger"
                    );

                    return;
                }

                if (!Number.isInteger(quantity) || quantity <= 0) {
                    showCartMessage(
                        "Số lượng phải lớn hơn 0.",
                        "warning"
                    );

                    quantityInput.focus();
                    return;
                }

                if (quantity > 99) {
                    showCartMessage(
                        "Số lượng tối đa là 99 sản phẩm.",
                        "warning"
                    );

                    quantityInput.value = 99;
                    quantityInput.focus();
                    return;
                }

                setAddButtonLoading(true);

                try {
                    const response = await fetch("/api/cart/add", {
                        method: "POST",
                        credentials: "include",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({
                            productId: currentProductId,
                            quantity: quantity
                        })
                    });

                    // Chưa đăng nhập
                    if (response.status === 401) {
                        const returnUrl = encodeURIComponent(
                            window.location.pathname
                            + window.location.search
                        );

                        window.location.href =
                            `/account/login?returnUrl=${returnUrl}`;

                        return;
                    }

                    const result = await readJsonResponse(response);

                    if (!response.ok) {
                        throw new Error(
                            result?.message
                            ?? result?.error
                            ?? result?.title
                            ?? "Không thể thêm sản phẩm vào giỏ hàng."
                        );
                    }

                    showCartMessage(
                        result?.message
                        ?? "Đã thêm sản phẩm vào giỏ hàng.",
                        "success",
                        true
                    );

                    updateCartCount(result);
                }
                catch (error) {
                    console.error("Add to cart error:", error);

                    showCartMessage(
                        error?.message
                        ?? "Không thể kết nối đến hệ thống giỏ hàng.",
                        "danger"
                    );
                }
                finally {
                    setAddButtonLoading(false);
                }
            }

            // ==================== CART MESSAGE ====================

            function showCartMessage(
                message,
                type,
                showCartLink = false
            ) {
                const messageContainer =
                    document.getElementById("cart-message");

                messageContainer.innerHTML = "";

                const alertElement =
                    document.createElement("div");

                alertElement.className =
                    `alert alert-${type} alert-dismissible fade show`;

                alertElement.setAttribute("role", "alert");

                const messageElement =
                    document.createElement("span");

                messageElement.textContent = message;

                alertElement.appendChild(messageElement);

                if (showCartLink) {
                    const cartLink =
                        document.createElement("a");

                    cartLink.href = "/cart";
                    cartLink.className = "alert-link ms-2";
                    cartLink.textContent = "Xem giỏ hàng";

                    alertElement.appendChild(cartLink);
                }

                const closeButton =
                    document.createElement("button");

                closeButton.type = "button";
                closeButton.className = "btn-close";
                closeButton.setAttribute(
                    "data-bs-dismiss",
                    "alert"
                );
                closeButton.setAttribute(
                    "aria-label",
                    "Đóng"
                );

                alertElement.appendChild(closeButton);
                messageContainer.appendChild(alertElement);
            }

            function clearCartMessage() {
                document.getElementById(
                    "cart-message"
                ).innerHTML = "";
            }

            // ==================== BUTTON LOADING ====================

            function setAddButtonLoading(isLoading) {
                const button =
                    document.getElementById(
                        "btn-add-to-cart"
                    );

                button.disabled = isLoading;

                if (isLoading) {
                    button.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"
                              aria-hidden="true">
                        </span>
                        Đang thêm...
                    `;
                }
                else {
                    button.innerHTML = `
                        <i class="fas fa-shopping-cart me-2"></i>
                        <span>Thêm vào giỏ</span>
                    `;
                }
            }

            // ==================== CART COUNT ====================

            function updateCartCount(result) {
                const cartCountElement =
                    document.getElementById("cart-count");

                if (!cartCountElement) {
                    return;
                }

                const cartCount =
                    result?.cartItemCount
                    ?? result?.totalQuantity
                    ?? result?.data?.cartItemCount
                    ?? result?.data?.totalQuantity;

                if (cartCount !== undefined
                    && cartCount !== null) {

                    cartCountElement.textContent =
                        cartCount;
                }
            }

            // ==================== ERROR ====================

            function showProductError(message) {
                document
                    .getElementById("product-loading")
                    .classList.add("d-none");

                document
                    .getElementById("product-content")
                    .classList.add("d-none");

                const errorContainer =
                    document.getElementById("product-error");

                document.getElementById(
                    "product-error-message"
                ).textContent = message;

                errorContainer.classList.remove("d-none");
            }

            // ==================== HELPERS ====================

            async function readJsonResponse(response) {
                const contentType =
                    response.headers.get("content-type") ?? "";

                if (!contentType.includes("application/json")) {
                    return null;
                }

                try {
                    return await response.json();
                }
                catch {
                    return null;
                }
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat("vi-VN", {
                    style: "currency",
                    currency: "VND"
                }).format(Number(value) || 0);
            }

            // ==================== REVIEWS LOGIC ====================

            function initStarRating() {
                const stars = document.querySelectorAll(".star-rating-select .star-btn");
                const ratingInput = document.getElementById("review-rating");
                const ratingLabel = document.getElementById("rating-label");

                const labels = {
                    1: "(1/5 Sao - Rất tệ)",
                    2: "(2/5 Sao - Tệ)",
                    3: "(3/5 Sao - Bình thường)",
                    4: "(4/5 Sao - Tốt)",
                    5: "(5/5 Sao - Rất tốt)"
                };

                stars.forEach(star => {
                    star.addEventListener("click", function () {
                        const val = Number.parseInt(this.getAttribute("data-value"), 10);
                        ratingInput.value = val;
                        if (ratingLabel) ratingLabel.textContent = labels[val] || `(${val}/5 Sao)`;
                        updateStarsUI(val);
                    });

                    star.addEventListener("mouseover", function () {
                        const val = Number.parseInt(this.getAttribute("data-value"), 10);
                        updateStarsUI(val);
                    });

                    star.addEventListener("mouseout", function () {
                        const currentVal = Number.parseInt(ratingInput.value, 10) || 5;
                        updateStarsUI(currentVal);
                    });
                });

                function updateStarsUI(val) {
                    stars.forEach(s => {
                        const starVal = Number.parseInt(s.getAttribute("data-value"), 10);
                        if (starVal <= val) {
                            s.classList.remove("far");
                            s.classList.add("fas");
                        } else {
                            s.classList.remove("fas");
                            s.classList.add("far");
                        }
                    });
                }
            }

            async function loadReviews(productId) {
                const reviewsLoading = document.getElementById("reviews-loading");
                const reviewsList = document.getElementById("reviews-list");
                const avgScoreEl = document.getElementById("avg-rating-score");
                const avgStarsEl = document.getElementById("avg-rating-stars");
                const totalCountEl = document.getElementById("total-reviews-count");

                if (!reviewsList || productId <= 0) return;

                try {
                    reviewsLoading?.classList.remove("d-none");

                    const response = await fetch(`/api/reviews/product/${productId}`);
                    if (!response.ok) throw new Error("Không thể tải danh sách bình luận.");

                    const data = await response.json();

                    const avg = data.averageRating || 0;
                    const total = data.totalReviews || 0;
                    const reviews = data.reviews || [];

                    if (avgScoreEl) avgScoreEl.textContent = avg.toFixed(1);
                    if (totalCountEl) totalCountEl.textContent = `${total} bình luận`;

                    if (avgStarsEl) {
                        avgStarsEl.innerHTML = renderStarsHtml(avg);
                    }

                    if (reviews.length === 0) {
                        reviewsList.innerHTML = `
                            <div class="text-center py-4 text-muted bg-light rounded">
                                <i class="far fa-comment-dots fs-1 d-block mb-2"></i>
                                Chưa có bình luận nào cho sản phẩm này. Hãy là người đầu tiên bình luận!
                            </div>
                        `;
                        return;
                    }

                    let html = "";
                    reviews.forEach(r => {
                        const formattedDate = new Date(r.createdAt).toLocaleString("vi-VN", {
                            day: "2-digit",
                            month: "2-digit",
                            year: "numeric",
                            hour: "2-digit",
                            minute: "2-digit"
                        });

                        const avatarSrc = r.userAvatar || "/images/user.svg";
                        const isOwner = currentUserId && r.userId === currentUserId;

                        html += `
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <img src="${avatarSrc}" alt="${escapeHtml(r.userName)}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover; border: 1px solid #ddd;" onerror="this.src='/images/user.svg'">
                                            <div>
                                                <h6 class="mb-0 fw-bold">${escapeHtml(r.userName)}</h6>
                                                <small class="text-muted">${formattedDate}</small>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="text-warning me-2">${renderStarsHtml(r.rating)}</span>
                                            ${isOwner ? `<button class="btn btn-sm btn-outline-danger border-0" onclick="deleteReview(${r.reviewId})" title="Xóa bình luận"><i class="fas fa-trash-alt"></i></button>` : ''}
                                        </div>
                                    </div>
                                    <p class="card-text text-dark mb-0 ps-5">${escapeHtml(r.comment)}</p>
                                </div>
                            </div>
                        `;
                    });

                    reviewsList.innerHTML = html;
                } catch (error) {
                    console.error("Error loading reviews:", error);
                    reviewsList.innerHTML = `
                        <div class="alert alert-danger text-center">
                            Không thể tải danh sách bình luận.
                        </div>
                    `;
                } finally {
                    reviewsLoading?.classList.add("d-none");
                }
            }

            async function handleReviewSubmit(e) {
                e.preventDefault();

                const rating = Number.parseInt(document.getElementById("review-rating")?.value || "5", 10);
                const commentInput = document.getElementById("review-comment");
                const comment = commentInput?.value?.trim() || "";
                const msgBox = document.getElementById("review-form-message");
                const btnSubmit = document.getElementById("btn-submit-review");

                if (!comment) {
                    showReviewMessage("Vui lòng nhập nội dung bình luận.", "danger");
                    return;
                }

                btnSubmit.disabled = true;
                btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...`;

                try {
                    const response = await fetch("/api/reviews", {
                        method: "POST",
                        credentials: "include",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({
                            productId: currentProductId || productIdFromRoute,
                            rating: rating,
                            comment: comment
                        })
                    });

                    if (response.status === 401) {
                        const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                        window.location.href = `/account/login?returnUrl=${returnUrl}`;
                        return;
                    }

                    const result = await readJsonResponse(response);

                    if (!response.ok) {
                        throw new Error(result?.message || result?.title || "Gửi bình luận thất bại.");
                    }

                    showReviewMessage(result?.message || "Đã đăng bình luận thành công!", "success");
                    commentInput.value = "";
                    loadReviews(currentProductId || productIdFromRoute);
                } catch (err) {
                    showReviewMessage(err?.message || "Lỗi kết nối khi gửi bình luận.", "danger");
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = `<i class="fas fa-paper-plane me-2"></i>Gửi bình luận`;
                }
            }

            async function deleteReview(reviewId) {
                if (!confirm("Bạn có chắc chắn muốn xóa bình luận này không?")) return;

                try {
                    const response = await fetch(`/api/reviews/${reviewId}`, {
                        method: "DELETE",
                        credentials: "include"
                    });

                    const result = await readJsonResponse(response);
                    if (!response.ok) {
                        alert(result?.message || "Không thể xóa bình luận.");
                        return;
                    }

                    loadReviews(currentProductId || productIdFromRoute);
                } catch (err) {
                    console.error("Delete review error:", err);
                    alert("Có lỗi xảy ra khi xóa bình luận.");
                }
            }

            function showReviewMessage(msg, type) {
                const box = document.getElementById("review-form-message");
                if (!box) return;
                box.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show py-2 mb-0" role="alert">${escapeHtml(msg)}<button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button></div>`;
            }

            function renderStarsHtml(rating) {
                let stars = "";
                const rounded = Math.round(rating);
                for (let i = 1; i <= 5; i++) {
                    if (i <= rounded) {
                        stars += `<i class="fas fa-star text-warning me-1"></i>`;
                    } else {
                        stars += `<i class="far fa-star text-muted me-1"></i>`;
                    }
                }
                return stars;
            }

            function escapeHtml(str) {
                if (!str) return "";
                return str
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        </script>
    }