		}

	.custom-navbar-nav .nav-item.dropdown:hover > .dropdown-menu {
		display: block;
		margin-top: 0;
	}

	.custom-navbar-nav .nav-item.dropdown:hover > .nav-link {
		color: #f9bf29 !important;
	}
	.custom-navbar-cta .dropdown-menu {
		padding: 0 !important;
		margin: 0 !important;
		overflow: hidden !important;
	}

		.custom-navbar-cta .dropdown-menu li {
			margin: 0 !important;
			padding: 0 !important;
		}

	.custom-navbar-cta .dropdown-item {
		padding: 12px 20px !important; 
		margin: 0 !important;
		border-radius: 0 !important; 
	}

	.custom-navbar-nav .nav-item.active .dropdown-menu a::before,
	.custom-navbar-nav .nav-item.active .dropdown-menu a::after {
		display: none !important;
	}

	.shop-category-dropdown-menu .dropdown-item.active {
		color: #000000 !important;
		background-color: #f9bf29 !important;
		font-weight: bold !important;
	}
</style>

