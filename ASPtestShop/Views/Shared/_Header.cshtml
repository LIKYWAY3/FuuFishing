<script>
	document.addEventListener("DOMContentLoaded", async function () {
		await loadNavbarCategories();
		setActiveNav();
	});
	//thêm hàm setActiveNav
	function setActiveNav() {
		const currentUrl = new URL(window.location.href);
		const currentPath = currentUrl.pathname.toLowerCase();
		const currentCatId = currentUrl.searchParams.get('categoryId');
		
		const navItems = document.querySelectorAll('.custom-navbar-nav .nav-item');
		const dropdownItems = document.querySelectorAll('.custom-navbar-nav .dropdown-item');
		
		// 1. Dọn dẹp sạch sẽ màu vàng cũ ở cả menu cha và menu con
		navItems.forEach(item => item.classList.remove('active'));
		dropdownItems.forEach(item => item.classList.remove('active'));

		let isMatched = false;

		if (currentPath === '/' || currentPath === '/home') {
			navItems[0].classList.add('active');
			isMatched = true;
		} 
		else if (currentPath === '/shop') {
			if (!currentCatId) {
				const topLinks = document.querySelectorAll('.custom-navbar-nav > li > a.nav-link');
				topLinks.forEach(link => {
					if (link.textContent.trim().toLowerCase() === 'shop') {
						link.closest('.nav-item').classList.add('active');
						isMatched = true;
					}
				});
			} 
			else {
				const allLinks = document.querySelectorAll('.custom-navbar-nav a');
				for (const link of allLinks) {
					const linkHref = link.getAttribute('href');
					if (linkHref) {
						try {
							const parsedLink = new URL(linkHref, window.location.origin);
							if (parsedLink.pathname.toLowerCase() === '/shop' && 
								parsedLink.searchParams.get('categoryId') === currentCatId) {
								
								link.closest('.nav-item').classList.add('active');
								
								if (link.classList.contains('dropdown-item')) {
									link.classList.add('active');
								}
								
								isMatched = true;
							}
						} catch(e) {}
					}
				}
			}
		}

		if (!isMatched) {
			navItems[0].classList.add('active');
		}
	}
	
	async function loadNavbarCategories() {
		try {
			const response = await fetch("/api/categories");

			if (!response.ok) {
				console.log("Không lấy được category");
				return;
			}

			const categories = await response.json();

			renderCategoryDropdown(categories, "Cần câu", "rodDropdown", "rodDropdownMenu");
			renderCategoryDropdown(categories, "Mồi câu", "baitDropdown", "baitDropdownMenu");
			renderCategoryDropdown(categories, "Dây câu", "lineDropdown", "lineDropdownMenu");
			renderCategoryDropdown(categories, "Phụ kiện", "accessoryDropdown", "accessoryDropdownMenu");

		} catch (error) {
			console.error("Lỗi load navbar categories:", error);
		}
	}

	function normalizeText(text) {
		return (text || "")
			.toString()
			.trim()
			.toLowerCase();
	}

	function renderCategoryDropdown(categories, parentCategoryName, linkId, menuId) {
		const link = document.getElementById(linkId);
		const menu = document.getElementById(menuId);

		if (!link || !menu) {
			return;
		}

		const parentCategory = categories.find(c =>
			normalizeText(c.categoryName) === normalizeText(parentCategoryName)
		);

		if (parentCategory) {
			link.href = `/Shop?categoryId=${parentCategory.categoryId}#products`;
		} else {
			link.href = "/Shop#products";
		}

		const childCategories = categories.filter(c => {
			const sameParentName =
				normalizeText(c.parentCategoryName) === normalizeText(parentCategoryName);

			const sameParentId =
				parentCategory && c.parentCategoryId === parentCategory.categoryId;

			return sameParentName || sameParentId;
		});

		menu.innerHTML = "";

		if (childCategories.length === 0) {
			menu.innerHTML = `
				<li>
					<span class="dropdown-item disabled">
						Chưa có danh mục con
					</span>
				</li>
			`;
			return;
		}

		childCategories.forEach(category => {
			menu.innerHTML += `
				<li>
					<a class="dropdown-item" href="/Shop?categoryId=${category.categoryId}#products">
						${category.categoryName}
					</a>
				</li>
			`;
		});
	}
</script>
<!-- End Header/Navigation -->